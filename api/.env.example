NODE_ENV=development
PORT=3000
CORS_ORIGIN=https://meudominio.com.br,https://api.meudominio.com.br
# Proxy configuration (optional, automatically auto-detected on Windows WinHTTP if unset)
# CAIXA_PROXY=http://10.0.1.32:3128
# HTTPS_PROXY=http://10.0.1.32:3128
# LOTTERY_DISABLE_PROXY=true

# Lottery API Provider preference (optional: loteriascaixa [default, recommended for servers/cloud], caixa, guidi)
# LOTTERY_API_PROVIDER=loteriascaixa