{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@module/*": ["./src/module/*"],
      "@core/*": ["./src/core/*"],
      "@email/*": ["./src/email/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*"
  ]
}