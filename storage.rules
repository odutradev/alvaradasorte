rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipts contain sensitive banking and PIX data (LGPD).
    // Direct client access is denied; access is granted only via backend pre-signed URLs.
    match /receipts/{sweepstakeId}/{receiptFile} {
      allow read, write: if false;
    }

    // User profile images
    match /avatars/{userId}/{imageFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny for all other files
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
